    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "AllowedHosts": "*",

    "EmailSettings": {
        "SenderName": "RNG Supra Villas",
        "SenderEmail": "admin.villacommunity@gmail.com",
        "SmtpServer": "smtp.gmail.com",
        "Port": 587,
        "Username": "admin.villacommunity@gmail.com",
        "Password": "" // REMOVED — will use User Secrets or Environment Variable
    },

    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
