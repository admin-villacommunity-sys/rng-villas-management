@model VillaCommunityManagement.Models.ResetPasswordViewModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="login-page">
    <div class="login-container">

        <div class="login-card">

            <div class="login-header">
                <div class="login-logo">
                    <i class="bi bi-key"></i>
                </div>
                <h1>Reset Password</h1>
                <p class="header-subtitle">Enter your new password</p>
            </div>

            <div class="login-body">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @ViewBag.Error
                    </div>
                }

                <form method="post">

                    @Html.HiddenFor(x => x.Token)
                    @Html.HiddenFor(x => x.Email)

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min 6 characters" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary login-btn">
                        <i class="bi bi-check-circle"></i> Reset Password
                    </button>

                </form>

                <div class="login-divider">
                    <span>or</span>
                </div>

                <div class="text-center">
                    <a asp-action="Index" class="guest-btn d-inline-block">
                        <i class="bi bi-arrow-left"></i> Back to Login
                    </a>
                </div>

            </div>

            <div class="login-footer">
                <span>© @DateTime.Now.Year RNG Supra Villas</span>
            </div>

        </div>

    </div>
</div>
