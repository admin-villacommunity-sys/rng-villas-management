@model VillaCommunityManagement.Models.ForgotPasswordViewModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="login-page">
    <div class="login-container">

        <div class="login-card">

            <div class="login-header">
                <div class="login-logo">
                    <i class="bi bi-key"></i>
                </div>
                <h1>Reset Password</h1>
                <p class="header-subtitle">Enter your email to receive a reset link</p>
            </div>

            <div class="login-body">

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle-fill"></i>
                        @ViewBag.Success
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @ViewBag.Error
                    </div>
                }

                <form method="post">

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your registered email"
                               autofocus />
                    </div>

                    <button type="submit" class="btn btn-primary login-btn">
                        <i class="bi bi-envelope"></i> Send Reset Link
                    </button>

                </form>

                <div class="login-divider">
                    <span>or</span>
                </div>

                <div class="text-center">
                    <a asp-action="Index" class="guest-btn d-inline-block">
                        <i class="bi bi-arrow-left"></i> Back to Login
                    </a>
                </div>

            </div>

            <div class="login-footer">
                <span>© @DateTime.Now.Year RNG Supra Villas</span>
            </div>

        </div>

    </div>
</div>