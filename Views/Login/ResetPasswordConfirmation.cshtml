@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Password Reset Complete";
}

<div class="login-page">
    <div class="login-container">

        <div class="login-card">

            <div class="login-header">
                <div class="login-logo" style="background: #10B981;">
                    <i class="bi bi-check-lg"></i>
                </div>
                <h1>Password Reset Complete</h1>
                <p class="header-subtitle" style="color: #10B981;">Your password has been changed successfully</p>
            </div>

            <div class="login-body text-center">

                <p class="text-muted mb-4">
                    You can now sign in with your new password.
                </p>

                <a asp-action="Index" class="btn btn-primary login-btn">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </a>

            </div>

            <div class="login-footer">
                <span>© @DateTime.Now.Year RNG Supra Villas</span>
            </div>

        </div>

    </div>
</div>