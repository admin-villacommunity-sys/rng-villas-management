@model VillaCommunityManagement.Models.Owner

@{
    ViewData["Title"] = "Villa Details";

    // Safe extraction of ViewBag values
    decimal totalPaid = ViewBag.TotalPaid != null ? (decimal)ViewBag.TotalPaid : 0;
    int pendingCount = ViewBag.PendingCount != null ? (int)ViewBag.PendingCount : 0;
    DateTime? lastPaymentDate = ViewBag.LastPaymentDate != null ? (DateTime)ViewBag.LastPaymentDate : (DateTime?)null;
    var maintenanceRecords = ViewBag.MaintenanceRecords as List<VillaCommunityManagement.Models.Maintenance> ?? new List<VillaCommunityManagement.Models.Maintenance>();
}

<div class="container-fluid px-0">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Villa @Model.Villa_No</h2>
            <p class="text-muted">Complete profile and maintenance history</p>
        </div>
        <div>
            <a asp-controller="Owner" asp-action="Edit" asp-route-id="@Model.Villa_No" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit Owner
            </a>
            <a href="/Dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- ========== OWNER INFO CARD ========== -->
    <div class="row g-4 mb-4">

        <div class="col-md-6">
            <div class="dashboard-panel">
                <h5><i class="bi bi-person-circle text-primary"></i> Owner Details</h5>
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted fw-semibold" style="width:120px;">Owner</td>
                        <td>@Model.Owner_name</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Tenant</td>
                        <td>@(string.IsNullOrWhiteSpace(Model.Tenant_name) ? "-" : Model.Tenant_name)</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Phone</td>
                        <td>@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Email</td>
                        <td>@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Status</td>
                        <td>
                            <span class="badge @(Model.Status == "Active" ? "bg-success" : Model.Status == "Vacant" ? "bg-danger" : "bg-warning text-dark")">
                                @Model.Status
                            </span>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- ========== PAYMENT SUMMARY ========== -->
        <div class="col-md-6">
            <div class="dashboard-panel">
                <h5><i class="bi bi-wallet2 text-primary"></i> Payment Summary</h5>
                <div class="row g-3 mt-2">
                    <div class="col-4">
                        <div class="bg-success bg-opacity-10 p-3 rounded-3 text-center">
                            <div class="small text-muted text-uppercase fw-semibold">Total Paid</div>
                            <h4 class="text-success fw-bold mb-0">₹ @totalPaid.ToString("N0")</h4>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-danger bg-opacity-10 p-3 rounded-3 text-center">
                            <div class="small text-muted text-uppercase fw-semibold">Pending</div>
                            <h4 class="text-danger fw-bold mb-0">@pendingCount</h4>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-info bg-opacity-10 p-3 rounded-3 text-center">
                            <div class="small text-muted text-uppercase fw-semibold">Last Payment</div>
                            <h5 class="fw-bold mb-0">
                                @if (lastPaymentDate.HasValue)
                                {
                                    @lastPaymentDate.Value.ToString("dd-MMM-yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ========== MAINTENANCE HISTORY ========== -->
    <div class="dashboard-panel">
        <h5><i class="bi bi-clock-history text-primary"></i> Maintenance History</h5>

        @if (maintenanceRecords.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Due Date</th>
                            <th>Due Amount</th>
                            <th>Paid Amount</th>
                            <th>Status</th>
                            <th>Payment Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in maintenanceRecords)
                        {
                            <tr>
                                <td>@item.Month</td>
                                <td>@item.Due.ToString("dd-MMM-yyyy")</td>
                                <td>₹ @String.Format("{0:N2}", item.DueAmount)</td>
                                <td>
                                    @if (item.paid.HasValue)
                                    {
                                        @String.Format("{0:N2}", item.paid.Value)
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Payment_details)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Payment_details && item.payment_date.HasValue)
                                    {
                                        @item.payment_date.Value.ToString("dd-MMM-yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No maintenance records found for this villa.</p>
        }
    </div>

    <!-- ========== QUICK ACTIONS ========== -->
    <div class="mt-4 d-flex gap-2 flex-wrap">
        <a asp-controller="Maintenance" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-plus-circle"></i> Add Maintenance
        </a>
        <a asp-controller="Maintenance" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-list"></i> View All Maintenance
        </a>
        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <a asp-controller="Maintenance" asp-action="SendReminderByVilla" asp-route-villaNo="@Model.Villa_No" class="btn btn-outline-warning">
                <i class="bi bi-envelope"></i> Send Reminder
            </a>
        }
    </div>

</div>