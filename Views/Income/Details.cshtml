@model VillaCommunityManagement.Models.Income

@{
    ViewData["Title"] = "Income Details";
}

<div class="card shadow-sm">

    <div class="card-header">

        <h3>Income Details</h3>

    </div>

    <div class="card-body">

        <table class="table">

            <tr>
                <th width="220">Month</th>
                <td>@Model.month</td>
            </tr>

            <tr>
                <th>Income Source</th>
                <td>@Model.income_source</td>
            </tr>

            <tr>
                <th>Amount</th>
                <td>₹ @String.Format("{0:N2}", Model.Amount)</td>
            </tr>

            <tr>
                <th>Details</th>
                <td>@Model.Income_Details</td>
            </tr>

        </table>

        <a asp-action="Edit"
           asp-route-id="@Model.IncomeId"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>