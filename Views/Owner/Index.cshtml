@using Microsoft.AspNetCore.Http
@model IEnumerable<VillaCommunityManagement.Models.Owner>

@{
    ViewData["Title"] = "Residents";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Residents</h2>
        <p class="text-muted mb-0">
            Manage owners and tenant information.
        </p>
    </div>

    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">
            Add Resident
        </a>
    }

</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-4">

                <input type="text"
                       id="searchBox"
                       class="form-control"
                       placeholder="Search by Villa, Owner or Tenant..." />

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle" id="residentTable">

                <thead class="table-light">

                    <tr>

                        <th>Villa</th>

                        <th>Owner</th>

                        <th>Tenant</th>

                        <th>Phone</th>

                        <th>Email</th>

                        <th>Status</th>

                        <th class="text-center">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>@item.Villa_No</strong>
                            </td>

                            <td>@item.Owner_name</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Tenant_name)
                                    ? "-"
                                    : item.Tenant_name)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Phone)
                                    ? "-"
                                    : item.Phone)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Email)
                                    ? "-"
                                    : item.Email)
                            </td>

                            <td>

                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else if (item.Status == "Vacant")
                                {
                                    <span class="badge bg-danger">
                                        Vacant
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.Status
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.Villa_No"
                                   class="btn btn-outline-primary btn-sm">
                                    View
                                </a>

                                @if (isAdmin)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Villa_No"
                                       class="btn btn-outline-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Villa_No"
                                       class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this resident?');">
                                        Delete
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

    document.getElementById("searchBox").addEventListener("keyup", function() {

        var value = this.value.toLowerCase();

        var rows = document.querySelectorAll("#residentTable tbody tr");

        rows.forEach(function(row) {

            row.style.display =
                row.innerText.toLowerCase().includes(value)
                    ? ""
                    : "none";

        });

    });

</script>